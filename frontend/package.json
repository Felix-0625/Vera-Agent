{
  "name": "vera-agent-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.json\" vite.config.ts \"../website/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.json\" vite.config.ts \"../website/**/*.{js,css,html}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
