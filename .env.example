# VeraAgent environment variables. None are required for the desktop app:
# configure model providers and API keys in the app under 设置 → 模型.
#
# These entries serve the Python CLI/model adapters, optional services, and development.
# To use them, copy the needed lines into the .env file in VERA_GLOBAL_CONFIG_DIR
# (default: %LOCALAPPDATA%\vera-agent\vera-agent). See docs/CONFIGURATION.md.

# --- Runtime paths and behavior ---
# VERA_GLOBAL_CONFIG_DIR=
# VERA_SILENT_STARTUP=1
# VERA_AGENT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
# VERA_AGENT_DESKTOP_URL=http://localhost:5173
# VERA_MINI_CONFIG_PATH=
# VERA_RUN_NETWORK_TESTS=1

# --- Python CLI / model adapters ---
MSWEA_MODEL_NAME=
OPENROUTER_API_KEY=
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
REQUESTY_API_KEY=
LITELLM_MODEL_REGISTRY_PATH=
MSWEA_COST_TRACKING=default

# Global limits for the Python process. Zero disables a limit.
MSWEA_GLOBAL_COST_LIMIT=0
MSWEA_GLOBAL_CALL_LIMIT=0
MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=10

# --- Optional services ---
TAVILY_API_KEY=

# --- Frontend build (read by npm/Vite, not by the Python .env) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
