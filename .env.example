# Optional environment values for the legacy Python CLI/model adapters.
# The desktop settings screen stores its selected model configuration separately.
# To use this file, copy the needed entries to VeraAgent's global .env location,
# or set VERA_GLOBAL_CONFIG_DIR to a directory containing a file named .env.

MSWEA_MODEL_NAME=
OPENROUTER_API_KEY=
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
TAVILY_API_KEY=

# Optional global limits. Zero means disabled.
MSWEA_GLOBAL_COST_LIMIT=0
MSWEA_GLOBAL_CALL_LIMIT=0
MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=10
