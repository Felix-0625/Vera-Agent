        </mxCell>
        <mxCell id="deliver" parent="1" vertex="1" value="回传原对话&#10;POST /api/threads/{id}/&#10;messages/deliver" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#edf8f3;strokeColor=#26806b;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="455" width="340" height="130" />
        </mxCell>
        <mxCell id="constraints" parent="1" vertex="1" value="约束&#10;组织：唯一根节点、唯一直接上级、无环、全为 agent。条件：true / false；循环：repeat / exit，最多 20 次。&#10;运行之间不共享对话历史；作用域允许的长期记忆仍可召回。关闭或刷新界面会中断调度，没有恢复执行入口。" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f3f5f8;strokeColor=#8897aa;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="675" width="1280" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
