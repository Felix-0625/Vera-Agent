        </mxCell>
        <mxCell id="gate" parent="1" vertex="1" value="Eval gate · model cost&#10;train: not worse → holdout: better&#10;→ guard: no regressions, else stop" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#fff7e8;strokeColor=#aa762a;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="530" y="425" width="340" height="130" />
        </mxCell>
        <mxCell id="adopt" parent="1" vertex="1" value="Recommended → user confirms&#10;Rule / prompt overlay / Skill&#10;Baseline includes adopted changes" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f4f0fb;strokeColor=#8460b3;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="1000" y="425" width="340" height="130" />
        </mxCell>
        <mxCell id="active" parent="1" vertex="1" value="Active profile on later turns&#10;Same rendering function as the gate&#10;Adopted rules bypass recall budget" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f4f0fb;strokeColor=#8460b3;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="1000" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="monitor" parent="1" vertex="1" value="Online monitor · user-triggered&#10;14 days before/after; ≥10 post traces&#10;Mean outcome drop ≥0.15 → rollback" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#edf8f3;strokeColor=#26806b;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="530" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="rollback" parent="1" vertex="1" value="Rollback with audit history&#10;Soft-delete rule / move Skill out&#10;Later turns stop applying proposal" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f3f5f8;strokeColor=#8897aa;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="limits" parent="1" vertex="1" value="Defaults and evidence limits&#10;Langfuse, Mem0, and consolidation are off by default; consolidation UPDATE/DELETE normally await confirmation.&#10;A guard pass describes that run; online before/after scores are observational, not a guarantee of improvement." style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f3f5f8;strokeColor=#8897aa;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="960" width="1280" height="105" />
        </mxCell>
