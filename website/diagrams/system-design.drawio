        </mxCell>
        <mxCell id="adopt" parent="1" vertex="1" value="推荐后，用户确认采纳&#10;规则 / prompt overlay / Skill&#10;基线包含已采纳的改进" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f4f0fb;strokeColor=#8460b3;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="1000" y="425" width="340" height="130" />
        </mxCell>
        <mxCell id="active" parent="1" vertex="1" value="活跃配置应用到后续回合&#10;与门禁使用同一套渲染函数&#10;采纳规则不占记忆召回预算" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f4f0fb;strokeColor=#8460b3;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="1000" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="monitor" parent="1" vertex="1" value="在线监控 · 用户触发&#10;前后 14 天；采纳后至少 10 条&#10;平均 outcome 下降 ≥0.15 → 回滚" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#edf8f3;strokeColor=#26806b;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="530" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="rollback" parent="1" vertex="1" value="回滚并保留审计记录&#10;规则软删除 / Skill 移出活跃目录&#10;后续回合不再应用该提案" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f3f5f8;strokeColor=#8897aa;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="720" width="340" height="130" />
        </mxCell>
        <mxCell id="limits" parent="1" vertex="1" value="默认与证据边界&#10;Langfuse 导出、Mem0 适配与自动整理默认关闭；consolidation 的 UPDATE / DELETE 通常等待用户确认。&#10;守护集通过只证明该次用例结果；在线前后对比是观察信号，不能证明因果或保证持续变强。" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#f3f5f8;strokeColor=#8897aa;fontSize=18;fontFamily=Microsoft YaHei;spacing=15;">
          <mxGeometry as="geometry" x="60" y="960" width="1280" height="105" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
